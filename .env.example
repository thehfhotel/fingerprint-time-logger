# =====================================================================
# .env.example — Template for .env (which is gitignored)
# =====================================================================
# Copy this to .env and fill in the secrets. Required values must be set
# in production (the app refuses to start without them).
# =====================================================================

# Environment (REQUIRED for production)
# Setting this to "dev", "development", "local", or "test" enables dev
# fallbacks for JWT_SECRET / ADMIN_PASSCODE_HASH (with logger.warning).
# Anything else (incl. unset) treats this as production: missing secrets
# cause a startup error.
ENV=production

# JWT signing secret (REQUIRED in production)
# Used for LINE OAuth (24h) and QR check-in (60s) tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_here

# Bcrypt hash of admin passcode (REQUIRED in production)
# Generate with: docker exec fingerprint-time-logger python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSCODE', bcrypt.gensalt(rounds=12)).decode())"
# DO NOT store the plaintext passcode here — only the bcrypt hash.
ADMIN_PASSCODE_HASH=your_bcrypt_hash_here

# CORS allowlist (comma-separated, no spaces)
# Browsers from these origins can call APIs with credentials. Keep narrow.
CORS_ALLOWED_ORIGINS=https://erp.thehfhotel.org,https://emp.thehfhotel.org

# Reverse Proxy Configuration
# Set true when behind nginx/Cloudflare. Enables cookie Secure flag,
# HSTS header, and CF-Connecting-IP / X-Forwarded-For trust.
BEHIND_PROXY=false

# Database
DATABASE_URL=sqlite:///./database/attendance.db

# ZKTeco Device
ZKTECO_HOST=192.168.100.209
ZKTECO_PORT=4370

# Auto-Import
AUTO_IMPORT_INTERVAL_MINUTES=30

# LINE OAuth (Optional - required for QR Check-in feature)
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CALLBACK_URL=your_callback_url
