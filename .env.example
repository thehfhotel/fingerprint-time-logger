# Database Configuration
DATABASE_URL=sqlite:///./database/attendance.db

# ZKTeco Device Configuration
ZKTECO_HOST=192.168.100.209
ZKTECO_PORT=4370

# Auto-Import Configuration
AUTO_IMPORT_INTERVAL_MINUTES=30

# Admin Console Security (REQUIRED)
# Generate hash by running: docker exec fingerprint-time-logger python scripts/generate_admin_hash.py
# DO NOT store plain text passcode here - only the bcrypt hash
ADMIN_PASSCODE_HASH=your_bcrypt_hash_here

# Reverse Proxy Configuration (Optional)
BEHIND_PROXY=false

# LINE OAuth Configuration (Optional - for QR Check-in)
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_REDIRECT_URI=your_redirect_uri
