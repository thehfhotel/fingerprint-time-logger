# =====================================================================
# .env.example — Template for .env (which is gitignored)
# =====================================================================
# Copy this to .env and fill in the secrets. Required values must be set
# in production (the app refuses to start without them).
# =====================================================================

# Environment (REQUIRED for production)
# Setting this to "dev", "development", "local", or "test" enables dev
# fallbacks for JWT_SECRET / ADMIN_PASSCODE_HASH (with logger.warning).
# Anything else (incl. unset) treats this as production: missing secrets
# cause a startup error.
ENV=production

# JWT signing secret (REQUIRED in production)
# Used for LINE OAuth (24h) and QR check-in (60s) tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_here

# Bcrypt hash of admin passcode (REQUIRED in production)
# Generate with: docker exec fingerprint-time-logger python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSCODE', bcrypt.gensalt(rounds=12)).decode())"
# DO NOT store the plaintext passcode here — only the bcrypt hash.
ADMIN_PASSCODE_HASH=your_bcrypt_hash_here

# CORS allowlist (comma-separated, no spaces)
# Browsers from these origins can call APIs with credentials. Keep narrow.
CORS_ALLOWED_ORIGINS=https://erp.thehfhotel.org,https://emp.thehfhotel.org

# Reverse Proxy Configuration
# Set true when behind nginx/Cloudflare. Enables cookie Secure flag,
# HSTS header, and CF-Connecting-IP / X-Forwarded-For trust.
BEHIND_PROXY=false

# Database
DATABASE_URL=sqlite:///./database/attendance.db

# ZKTeco Device
ZKTECO_HOST=192.168.100.209
ZKTECO_PORT=4370

# Auto-Import
AUTO_IMPORT_INTERVAL_MINUTES=30

# LINE OAuth (Optional - required for QR Check-in feature)
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CALLBACK_URL=your_callback_url

# Same-browser LINE completion hand-off (Optional; ships DARK — off unless set
# to true). Fixes the one dead end a password-less staff LINE account hits: the
# Cloudflare Access flow opened from a phone's NON-LINE browser, where LINE can
# only offer an email/password form the account cannot complete. With this on,
# auto login is kept, LINE finishes in its own in-app browser, and the ORIGINAL
# tab long-polls a server-side ticket and completes the Access redirect itself —
# so the Access session never has to survive the trip through LINE's separate
# cookie jar. See app/services/line_handoff_store.py for the design and the
# threat analysis. With it OFF, that combination keeps today's Thai guidance
# interstitial, which also stays as the fallback when it IS on.
# The two WAIT knobs mirror READER_WAIT_* and exist for fast tests.
#
# LEAVE THIS FALSE. Owner decision 2026-08-14 — not "unfinished", DECLINED.
# Turning it on lets a colleague on the same WiFi take over another
# employee's Cloudflare Access session (payroll and reimbursement included):
# they start a hand-off, send the victim the LINE link, the victim logs in
# from the same egress IP so the binding passes, and their tab collects the
# session. All hotel staff share one NAT. It buys one saved step for a maid
# who arrives off her normal path; her normal path is the LINE rich menu,
# where login already works. Read the is_enabled() docstring in
# app/services/line_handoff_store.py before reconsidering.
LINE_SAME_BROWSER_HANDOFF=false
LINE_HANDOFF_TICKET_TTL_SECONDS=
LINE_HANDOFF_WAIT_TIMEOUT_SECONDS=
LINE_HANDOFF_WAIT_TICK_SECONDS=

# HF ID — OIDC identity provider (Optional; ships DARK until HFID_SIGNING_KEY
# is set). LINE-brokered employee SSO for Cloudflare Access. See
# app/services/oidc_service.py. Generate the key with: openssl genrsa 2048
# (paste the PEM here; multi-line PEM or a single line with \n escapes both
# work). HFID_ISSUER / HFID_REDIRECT_URIS default to the id.thehfhotel.org
# issuer and the laikaexpress Cloudflare Access callback respectively.
HFID_SIGNING_KEY=
HFID_CLIENT_ID=
HFID_CLIENT_SECRET=
HFID_ISSUER=
HFID_REDIRECT_URIS=

# HF Portal manager directory — WHO COUNTS AS AN ADMIN for Cloudflare Access
# auto-login (app/services/manager_directory.py).
#
# The portal owns the "HF Managers" Cloudflare Access tier and publishes its
# live membership at GET /portal-api/directory/managers. This app polls that
# every 60s on a background thread so a manager added or removed via the portal
# Access menu actually reaches the attendance admin console — no code change,
# no redeploy.
#
#   PORTAL_DIRECTORY_URL   — not a secret. Defaults to the container-network
#                            address below; only override for local dev.
#   PORTAL_DIRECTORY_TOKEN — the portal's PORTAL_DIRECTORY_TOKEN bearer value.
#                            EMPTY = dormant: zero network calls, and the admin
#                            allowlist is exactly the CF_ADMIN_EMAILS / in-code
#                            floor below. In production this MUST be set as the
#                            GitHub secret PORTAL_DIRECTORY_TOKEN — the deploy
#                            rewrites the container .env from the workflow
#                            payload every time, so a hand-set host value is
#                            wiped on the next deploy.
#
# Fail-closed by construction: a 401/503/timeout/malformed answer, or a 200
# carrying an empty list, keeps the last known-good set rather than revoking
# anyone; if the portal has never answered, the floor below applies.
PORTAL_DIRECTORY_URL=http://hf-erp-portal:3000/portal-api/directory/managers
PORTAL_DIRECTORY_TOKEN=

# Admin allowlist FLOOR (Optional) — comma-separated, no spaces. Applies only
# while no live portal directory answer has ever been obtained (portal dormant,
# down, or unreachable). Unset, the floor is the in-code manager list in
# app/services/manager_directory.py (STATIC_ADMIN_EMAILS).
#
# Setting this replaces that in-code list wholesale, protected owner included —
# it is the deliberate local manual control. NOTE: it is intentionally NOT
# passed through docker-compose.yml (like the other CF_* knobs), so setting it
# here has no effect on the container; it is a source-level / local-run knob.
# CF_ADMIN_EMAILS=

# Card-login secrets — HF ID as the central card-login authority (Optional;
# each surface is dark/404 until its secret is set; X-Reader-Secret header,
# constant-time check). See app/api/reader.py.
#   READER_RESOLVE_SECRET — APP↔CENTRAL: app backends call /resolve, /claim and
#     /wait (long-poll a tap → signed card assertion). /wait also needs
#     HFID_SIGNING_KEY set to mint the assertion.
#   READER_SECRET — READER↔CENTRAL: only the ESP32 reader calls /scan (tap
#     ingest). Kept separate so a compromised app backend can't forge taps.
READER_RESOLVE_SECRET=
READER_SECRET=

# Employee Hub — staff LINE OA (Optional; the whole feature is DARK until both
# are set). A DIFFERENT channel from LINE_CHANNEL_* above (that one is the LINE
# Login channel behind QR check-in). See docs/EMPLOYEE_HUB_SETUP.md.
STAFF_OA_CHANNEL_ACCESS_TOKEN=
STAFF_OA_CHANNEL_SECRET=

# Guest-feedback group forwarder (Optional; dark while the URL is empty).
# LINE allows one Official Account per group chat, so the staff group hosts the
# staff OA above and the guest-feedback app cannot get that group's events
# directly. The staff-OA webhook relays them — reduced payload only ({type,
# replyToken, timestamp, groupId, channel}), never message text, never a
# user/room event — and guest-feedback replies into the group with the staff
# OA's token. The URL is not a secret (container-to-container over the
# shared-nginx network, no Cloudflare Access in the path); the secret rides the
# X-Reader-Secret header and is NOT the same value as READER_SECRET.
# Production URL: http://feedback:4080/api/internal/line/event
GUEST_FEEDBACK_LINE_URL=
GUEST_FEEDBACK_LINE_SECRET=

# Staff bot read side (Optional; the digest is DARK while the token is empty).
# The staff OA is also a bot (HF ภายใน): summoned with น้องคะ in the staff group
# or messaged 1:1, it answers งานค้าง with housekeeping's open แจ้งซ่อม rows.
# HF ID reads them server-to-server over the shared-nginx network — no
# Cloudflare Access in the path, a bearer token instead. The URL is not a
# secret and already defaults to the production value; the token is, and it
# must be the SAME value as housekeeping's STAFF_BOT_INGRESS_TOKEN. Empty
# token ⇒ nothing is dialed and the bot says
# "ระบบงานซ่อมยังไม่เชื่อมต่อ ลองใหม่อีกครั้งภายหลัง".
# Endpoint: GET {HOUSEKEEPING_INTERNAL_URL}/internal/staff-bot/digest
HOUSEKEEPING_INTERNAL_URL=http://housekeeping:4070
HOUSEKEEPING_STAFF_BOT_TOKEN=
